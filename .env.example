# Oktz-RS environment configuration
# Salin ke .env lalu isi sesuai kebutuhan. Semua nilai opsional; default bawaan dipakai jika kosong.

# Owner
OWNER_NUMBERS=6285608953677
OWNER_NAME=Oktz

# Info
INFO_WEBSITE=https://oktzz.xyz
INFO_GRUPWA=https://chat.whatsapp.com/H1MOIGsWKuK1ulzOBAjW9b

# Bot
BOT_NAME=Oktz Bot
BOT_VERSION=3.3.1
BOT_DEVELOPER=Zann
BOT_WEBSITE=https://oktzz.xyz

# Sticker
STICKER_PACKNAME=𝗙𝗢𝗧𝗢 𝗗𝗘𝗟𝗨𝗫𝗘
STICKER_AUTHOR=Zann

# Saluran
SALURAN_ID=120363411617217441@newsletter
SALURAN_NAME=Join saluran resmi Oktz
SALURAN_LINK=https://whatsapp.com/channel/0029Vb8z7S0KrWQvCa8i0J0I

# Session / pairing
PAIRING_NUMBER=
USE_PAIRING_CODE=true
PAIRING_RATE_LIMIT_COOLDOWN_MS=3600000
SESSION_PAIRING_FALLBACK_TO_QR=true
SESSION_QR_DIR=qr
SESSION_QR_PNG_WIDTH=320
SESSION_QR_MAX_PRINTS=5
SESSION_KEEP_ALIVE_INTERVAL_MS=30000

# Database
DATABASE_PATH=./database/main
TURSO_URL=
TURSO_AUTH_TOKEN=
TURSO_SYNC_INTERVAL=5000
TURSO_ENABLED=false

# Energi
ENERGI_ENABLED=true
ENERGI_DEFAULT=99999
ENERGI_PREMIUM=99999999
ENERGI_OWNER=-1

# Error template (kosong = bawaan)
ERROR_TEMPLATE=

# API keys
APIKEY_NEOXR=
APIKEY_FGSI=
GROQ_API_KEY=
APIKEY_COVENANT=
APIKEY_OBSCURA=
APIKEY_FIREFLY=
APIKEY_CUKI=
LINODE_API_TOKEN=

# DigitalOcean
DIGITALOCEAN_TOKEN=
DIGITALOCEAN_SELLERS=
DIGITALOCEAN_OWNER_PANELS=

# Infra
OKTZ_CONFIG=config.json
OKTZ_CONFIG_JSON=
OKTZ_ASSETS_JSON=
OKTZ_PAYMENT_JSON=
OKTZ_DONASI_JSON=
OKTZ_MESSAGES_JSON=
OKTZ_DB_DIR=

# Config file override (JSON kompleks)
# OKTZ_CONFIG_JSON={"owner":{"name":"..."},"bot":{"name":"..."}}

# Optional location of config.json
# OKTZ_CONFIG=/path/to/config.json
